# Keep the build context small and reproducible: never ship local virtualenvs,
# caches, VCS metadata, or the bulk reference downloads/indexes into the image
# (the index is built inside the container into a mounted volume, not baked in).
.git
.gitignore
.venv
venv
env
ENV
__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov
coverage.xml
build
dist
*.egg-info
.eggs

# Bulk reference data and built indexes (mounted at run time, not copied in).
data/reference/
data/cache/

# Node modules and a stale local build: the web stage installs from the
# lockfile and builds fresh, and node_modules alone is ~185 MB of context.
web/node_modules/
web/dist/
web/.vite/

# Benchmark exports and committed run outputs: developer material, not runtime.
data/testing/
results/
docs/
tests/

# Editor / OS cruft
.idea
.vscode
*.swp
.DS_Store
Thumbs.db
